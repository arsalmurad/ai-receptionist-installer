# Copy this file to .env.local at the repo root and fill in real values.
# .env.local is gitignored - never commit real credentials.
#
# Don't have any of these yet? Run `npm run demo` instead - it starts the
# whole app against a local Supabase instance with the mock LLM provider
# and seeded demo data, no external accounts needed. See README "Local
# development".
#
# Full descriptions: docs/ENV_CONTRACT.md (source of truth, generated from
# packages/config/src/envVarNames.ts).

# ---------------------------------------------------------------------------
# Public (sent to the browser) - required
# ---------------------------------------------------------------------------

# Supabase project URL. Without it, the build fails immediately - nothing
# in this app works without a database.
NEXT_PUBLIC_SUPABASE_URL=

# Supabase anon key (RLS-scoped, safe to expose). Same as above: required,
# the build fails without it.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# This deployment's public URL, used in outgoing links (e.g. owner emails).
# Optional - links just fall back to a relative path without it.
NEXT_PUBLIC_SITE_URL=

# ---------------------------------------------------------------------------
# Server-only - required
# ---------------------------------------------------------------------------

# Bypasses RLS entirely. Required - the build fails without it. Never
# prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Used by the CLI to link and push migrations. Required for `frontdesk
# provision`'s migration step; the app itself runs without it once
# migrations are already applied.
SUPABASE_PROJECT_REF=

# Selects clients/<id>/config.json for this deployment. Required - the
# build fails without it.
CLIENT_ID=demo-plumbing

# URL of the deployed llm-gateway Worker. Required - the chat route has
# nothing to call without it.
LLM_GATEWAY_URL=

# Shared secret between apps/web and llm-gateway, min 16 characters.
# Required - without it the chat route can't authenticate to the gateway.
LLM_GATEWAY_SHARED_SECRET=

# ---------------------------------------------------------------------------
# Server-only - optional (each gates one integration on/off)
# ---------------------------------------------------------------------------

# Used by the CLI for non-interactive `supabase db push`. Without it,
# provisioning's migration step is skipped, not failed.
SUPABASE_DB_PASSWORD=

# Lets `frontdesk verify`/`frontdesk check` identify their own chat
# requests so they use a separate rate-limit namespace and a mock reply
# instead of spending the public chat quota. Min 16 characters. Without
# it, verify falls back to spending the real public quota like any
# visitor.
VERIFY_TOKEN=

# Enables Twilio REST provisioning (phone number config). Without it,
# that provision/verify step is skipped - the voice webhook itself still
# works and is testable via gate 4 / scripts/simulate-call.ts.
TWILIO_ACCOUNT_SID=

# Enables X-Twilio-Signature verification on the voice webhooks. Without
# it, incoming webhook requests are accepted without signature checking -
# fine for local dev, not for a real deployment.
TWILIO_AUTH_TOKEN=

# The Twilio phone number resource `frontdesk provision` points at this
# deployment. Without it, that provisioning step is skipped.
TWILIO_PHONE_NUMBER_SID=

# The Twilio-hosted TwiML Bin URL from docs/FALLBACK_TWIML.md, set as the
# number's Fallback URL. Without it, that provisioning step is skipped.
TWILIO_FALLBACK_TWIML_URL=

# Enables the ElevenLabs agent handoff and provisioning. Without both this
# and ELEVENLABS_AGENT_ID, voice features report themselves as disabled
# instead of crashing.
ELEVENLABS_API_KEY=

# An existing agent (created from the Blank template in the ElevenLabs
# dashboard) that `frontdesk provision` configures. Never created by this
# project - you make it once by hand.
ELEVENLABS_AGENT_ID=

# Enables owner email notifications. Without both this and
# RESEND_FROM_DOMAIN, leads are still saved, just not emailed.
RESEND_API_KEY=

# Verified sending domain for owner notifications.
RESEND_FROM_DOMAIN=

# Override for the alert recipient. Defaults to the client config's
# ownerNotificationEmail if unset.
OWNER_NOTIFICATION_EMAIL=

# Number dialed by the fallback TwiML when the AI agent can't be reached.
OWNER_FALLBACK_PHONE=

# URL of the deployed media-gate Worker. Without both this and
# MEDIA_GATE_SIGNING_SECRET, signed media links are disabled.
MEDIA_GATE_URL=

# Shared secret for HMAC-signed, expiring media URLs. Min 16 characters.
MEDIA_GATE_SIGNING_SECRET=

# Used by the CLI to deploy Workers (wrangler).
CLOUDFLARE_ACCOUNT_ID=

# Used by CI to deploy Workers non-interactively. Local dev can instead
# rely on an already-`wrangler login`'d session, leaving this blank.
CLOUDFLARE_API_TOKEN=

# ---------------------------------------------------------------------------
# Rate limits - all optional, all have working defaults (see
# docs/ENV_CONTRACT.md for every default value)
# ---------------------------------------------------------------------------

CHAT_RATE_LIMIT_PER_IP=
CHAT_RATE_LIMIT_WINDOW_MS=
CHAT_RATE_LIMIT_DAILY=
VERIFY_RATE_LIMIT_PER_IP=
VERIFY_RATE_LIMIT_DAILY=
VOICE_RATE_LIMIT_PER_IP=
VOICE_RATE_LIMIT_WINDOW_MS=
OWNER_EMAIL_DAILY_CAP=
WEB_VOICE_RATE_LIMIT_PER_IP=
WEB_VOICE_RATE_LIMIT_WINDOW_MS=
WEB_VOICE_DAILY_CAP=

# ---------------------------------------------------------------------------
# workers/llm-gateway only - not read by apps/web, only relevant if you're
# running or deploying the Worker yourself. LLM_PROVIDER/LLM_MODEL are
# non-secret and normally live in workers/llm-gateway/wrangler.toml
# instead; set them here only for local `wrangler dev`.
# ---------------------------------------------------------------------------

# "mock" (no key needed, deterministic FAQ-matching answers), "gemini", or
# "openai". Required for the Worker to start; "mock" needs nothing else
# below.
LLM_PROVIDER=mock

# Model id for the chosen provider. Ignored when LLM_PROVIDER=mock.
LLM_MODEL=

# API key for the chosen provider. Required when LLM_PROVIDER is "gemini"
# or "openai", ignored for "mock".
LLM_API_KEY=
